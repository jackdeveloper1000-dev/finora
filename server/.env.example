NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finora_db
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Optional
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Malware scanning: none | clamav (needs a running clamd). Use clamav in production.
SCAN_PROVIDER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCAN_FAIL_CLOSED=true


# Google sign-in: the OAuth client ID only (no secret is needed for the ID-token flow)
GOOGLE_CLIENT_ID=

# Email (verification codes, password reset). Without MAIL_PASSWORD, messages are printed to the server log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Finora
MAIL_ENCRYPTION=ssl
