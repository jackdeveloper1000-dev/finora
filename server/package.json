{
  "name": "finora-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/config/initDb.js",
    "db:migrate": "node src/config/migrate.js",
    "user:staff": "node src/config/createStaff.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 --import ./test/integration/setup.js \"test/integration/*.itest.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
